            "anyOf": [
              { "$ref": "#/$defs/shape22" },
              { "$ref": "#/$defs/shape23" },
              { "$ref": "#/$defs/shape24" },
              { "$ref": "#/$defs/shape25" },
              { "$ref": "#/$defs/shape26" },
              { "$ref": "#/$defs/shape27" },
              { "$ref": "#/$defs/shape28" },
              { "$ref": "#/$defs/shape29" },
              { "$ref": "#/$defs/shape30" },
              { "$ref": "#/$defs/shape31" },
              { "$ref": "#/$defs/shape32" },
              { "$ref": "#/$defs/shape34" },
              { "$ref": "#/$defs/shape35" },
