              { "$ref": "#/$defs/shape3" },
              { "$ref": "#/$defs/shape7" },
              { "$ref": "#/$defs/shape8" },
              { "$ref": "#/$defs/shape9" },
              { "$ref": "#/$defs/shape17" },
              { "$ref": "#/$defs/shape21" }
            ]
          }
        },
        "flow": {
