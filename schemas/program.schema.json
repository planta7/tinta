              { "$ref": "#/$defs/shape25" },
              { "$ref": "#/$defs/shape26" },
              { "$ref": "#/$defs/shape27" },
              { "$ref": "#/$defs/shape28" },
              { "$ref": "#/$defs/shape29" },
              { "$ref": "#/$defs/shape30" },
