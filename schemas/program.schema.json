    "shape9": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "span": { "$ref": "#/$defs/shape5" },
        "kind": { "anyOf": [{ "const": "let" }, { "const": "calc" }] },
        "expression": {
          "anyOf": [
            { "$ref": "#/$defs/shape10" },
            { "$ref": "#/$defs/shape11" },
            { "$ref": "#/$defs/shape12" },
            { "$ref": "#/$defs/shape13" },
            { "$ref": "#/$defs/shape14" },
            { "$ref": "#/$defs/shape15" },
            { "$ref": "#/$defs/shape16" }
