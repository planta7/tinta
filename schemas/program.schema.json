              { "$ref": "#/$defs/shape37" },
              { "$ref": "#/$defs/shape38" },
              { "$ref": "#/$defs/shape39" }
            ]
          }
        }
      },
      "required": [
        "abi",
        "sourceVersion",
        "contractRevision",
        "profile",
        "source",
        "sourceUri",
        "sourceSha256",
        "metadata",
        "declarations",
        "flow"
