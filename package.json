{
  "name": "tinta-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --coverage",
    "test:conformance": "node scripts/capabilities.mjs conformance",
    "test:browser": "node scripts/capabilities.mjs browser",
    "build": "tsc -b && node scripts/build.mjs",
    "check:architecture": "node scripts/architecture.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "verify": "node scripts/verify.mjs",
    "test:browser:infrastructure": "playwright test",
    "check:dependencies": "node scripts/dependencies.mjs",
    "test:hardening": "node scripts/hardening.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "pnpm build && vite apps/studio --config apps/studio/vite.config.js",
    "preview": "vite preview apps/studio --config apps/studio/vite.config.js",
    "build:vscode": "tsc -b apps/vscode apps/studio/tsconfig.preview.json packages/language-server && node scripts/build.mjs vscode",
    "test:vscode:unit": "vitest run --config scripts/vscode-vitest.config.js --coverage",
    "test:vscode:browser": "playwright test --config scripts/vscode-playwright.config.js",
    "package:vscode": "pnpm build:vscode && node scripts/package-vscode.mjs",
    "build:language": "tsc -b packages/language-server packages/local-files packages/reader && node scripts/build.mjs language",
    "build:studio": "tsc -b apps/studio packages/cli && node scripts/build.mjs studio"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@tinta-lang/cli": "workspace:*",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/vsce": "2.26.1",
    "ajv": "8.20.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "release-it": "21.1.1",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
