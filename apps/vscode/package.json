{
  "name": "@tinta-lang/vscode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "vscode-languageclient": "10.1.2",
    "@tinta-lang/types": "workspace:*",
    "@tinta-lang/local-files": "workspace:*",
    "@tinta-lang/artifacts": "workspace:*"
  },
  "displayName": "tinta",
  "description": "Tinta language support: interactive documents with controls, calculations and charts, Markdown compatibility, live preview and HTML export.",
  "icon": "icon.png",
  "publisher": "tinta-local",
  "engines": {
    "vscode": "^1.141.0"
  },
  "main": "./dist/extension.mjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onLanguage:tinta"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tinta",
        "aliases": [
          "tinta"
        ],
        "extensions": [
          ".tinta"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tinta",
        "scopeName": "text.html.markdown.tinta",
        "path": "./syntaxes/tinta.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tinta.check",
        "title": "tinta: Check"
      },
      {
        "command": "tinta.showSource",
        "title": "tinta: Show Source",
        "icon": "$(code)"
      },
      {
        "command": "tinta.openPreview",
        "title": "tinta: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "tinta.showPreview",
        "title": "tinta: Show Preview",
        "icon": "$(preview)"
      },
      {
        "command": "tinta.previewCopy",
        "title": "tinta: Create UTF-8/LF Copy for Preview"
      },
      {
        "command": "tinta.resetReading",
        "title": "tinta: Reset Reading"
      },
      {
        "command": "tinta.selectImageRoot",
        "title": "tinta: Select Image Root",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.refreshImages",
        "title": "tinta: Refresh Images",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.enrichMarkdown",
        "title": "tinta: Enrich Markdown",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.openSourceBundle",
        "title": "tinta: Open Source Bundle",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.saveSourceBundle",
        "title": "tinta: Save Source Bundle",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.exportInteractive",
        "title": "tinta: Export Interactive HTML",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "tinta.exportStatic",
        "title": "tinta: Export Static HTML",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configurationDefaults": {
      "[tinta]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": true,
        "editor.autoIndent": "keep",
        "editor.wordBasedSuggestions": "off"
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tinta.showSource",
          "when": "(resourceLangId == tinta && (resourceScheme == file || resourceScheme == untitled)) || activeWebviewPanelId == tinta.preview",
          "group": "navigation@1"
        },
        {
          "command": "tinta.openPreview",
          "when": "(resourceLangId == tinta && (resourceScheme == file || resourceScheme == untitled)) || activeWebviewPanelId == tinta.preview",
          "group": "navigation@2"
        },
        {
          "command": "tinta.showPreview",
          "when": "(resourceLangId == tinta && (resourceScheme == file || resourceScheme == untitled)) || activeWebviewPanelId == tinta.preview",
          "group": "navigation@3"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "@tinta-lang/engine": "workspace:*"
  }
}
