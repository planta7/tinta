{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": ["string", "comment"]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "folding": {
    "offSide": false
  },
  "indentationRules": {
    "increaseIndentPattern": "(?!)",
    "decreaseIndentPattern": "(?!)"
  }
}
