{
  "name": "@tinta-lang/cli",
  "version": "0.0.0",
  "description": "Check, enrich, bundle and export tinta documents from the command line.",
  "keywords": [
    "tinta",
    "cli",
    "markdown",
    "documents"
  ],
  "homepage": "https://github.com/planta7/tinta/blob/main/packages/cli/README.md",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tinta-lang/types": "workspace:*",
    "@tinta-lang/engine": "workspace:*",
    "@tinta-lang/artifacts": "workspace:*",
    "@tinta-lang/local-files": "workspace:*"
  },
  "bin": {
    "tinta": "./bin.mjs"
  },
  "files": [
    "dist",
    "assets",
    "bin.mjs"
  ]
}
