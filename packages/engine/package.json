{
  "name": "@tinta-lang/engine",
  "version": "0.0.0",
  "description": "Compile and evaluate interactive tinta documents with transactional controls.",
  "keywords": [
    "tinta",
    "markdown",
    "expressions",
    "documents"
  ],
  "homepage": "https://github.com/planta7/tinta/blob/main/packages/engine/README.md",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart-presentation": {
      "types": "./dist/chart-presentation.d.ts",
      "import": "./dist/chart-presentation.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "dependencies": {
    "@tinta-lang/types": "workspace:*",
    "@tinta-lang/syntax": "workspace:*",
    "@noble/hashes": "2.4.0"
  },
  "files": [
    "dist"
  ]
}
